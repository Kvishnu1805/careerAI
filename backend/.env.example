# CareerAI Environment Configuration

# Database: MySQL (Default local or cloud) or SQLite fallback
# MySQL Example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/careerai
# SQLite (Automatic Fallback):
DATABASE_URL=sqlite:///./careerai.db

# JWT Authentication
JWT_SECRET=replace-with-a-very-secure-random-secret-key-in-production

# AI Services (Optional - mock intelligent engine automatically activates if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

